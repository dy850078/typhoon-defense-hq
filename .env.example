# 複製一份成 .env，填上自己的值（.env 不會被推上 GitHub）
# 不需要的就留空或整行刪掉

# 小樹屋語音：Cloudflare TURN
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=

# 管理員密碼（不設的話每次啟動會印在畫面上）
ADMIN_PASSWORD=

# 固定的視訊房間名稱
JITSI_ROOM=

# 固定網址的通道（npm run tunnel:setup 會自動填，不用手動改）
TUNNEL=
PUBLIC_URL=

# 寄驗證信和重設密碼信（Resend，https://resend.com）
# 沒設 RESEND_API_KEY 的話信不會真的寄出，只會印在終端機上
RESEND_API_KEY=
MAIL_FROM=info@thisisnotahq.com
